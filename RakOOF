-- 11. WEAPON SELECTION & AUTO ATTACK
--------------------------------------------------------------------------------
local function getBestWeapon()
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not character or not backpack then return nil end

    for _, weaponName in ipairs(WEAPON_PRIORITY) do
        local equipped = character:FindFirstChild(weaponName)
        if equipped and equipped:IsA("Tool") then return equipped end
        
        local inBackpack = backpack:FindFirstChild(weaponName)
        if inBackpack and inBackpack:IsA("Tool") then return inBackpack end
    end
    
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then return tool end
    end

    return nil
end

local function equipAndAttack()
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local bestTool = getBestWeapon()
    
    if humanoid and bestTool then
        if bestTool.Parent ~= character then
            humanoid:EquipTool(bestTool)
        end
        bestTool:Activate()
    end
end

