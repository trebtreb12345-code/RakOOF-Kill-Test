--------------------------------------------------------------------------------
-- 6. WEAPON SELECTION & ATTACK SYSTEM
--------------------------------------------------------------------------------
local function getBestWeapon()
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not character or not backpack then return nil end

    -- Check configured priority weapons first
    for _, weaponName in ipairs(WEAPON_PRIORITY) do
        local equipped = character:FindFirstChild(weaponName)
        if equipped and equipped:IsA("Tool") then return equipped end
        
        local inBackpack = backpack:FindFirstChild(weaponName)
        if inBackpack and inBackpack:IsA("Tool") then return inBackpack end
    end
    
    -- Fallback to any tool available in Backpack
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then return tool end
    end

    return nil
end

local function equipAndAttack()
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local bestTool = getBestWeapon()
    
    if humanoid and bestTool then
        if bestTool.Parent ~= character then
            humanoid:EquipTool(bestTool)
        end
        bestTool:Activate()
    end
end

TPBtn.MouseButton1Click:Connect(function()
    local boss, bossRoot = findBossRoot()
    local character = LocalPlayer.Character
    if bossRoot and character and character:FindFirstChild("HumanoidRootPart") then
        character.HumanoidRootPart.CFrame = bossRoot.CFrame * CFrame.new(0, 0, AUTO_KILL_DISTANCE)
    end
end)

AutoKillBtn.MouseButton1Click:Connect(function()
    AUTO_KILL_ENABLED = not AUTO_KILL_ENABLED
    
    if AUTO_KILL_ENABLED then
        AutoKillBtn.Text = "Auto Attack: ON"
        AutoKillBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 120)
        
        connectionLoop = RunService.Heartbeat:Connect(function()
            local boss, bossRoot = findBossRoot()
            local character = LocalPlayer.Character
            
            if bossRoot and character and character:FindFirstChild("HumanoidRootPart") then
                character.HumanoidRootPart.CFrame = bossRoot.CFrame * CFrame.new(0, 0, AUTO_KILL_DISTANCE)
                equipAndAttack()
            else
                if AUTO_PICKUP_ENABLED then
                    teleportToDroppedItems()
                end
            end
        end)
    else
        AutoKillBtn.Text = "Auto Attack: OFF"
        AutoKillBtn.BackgroundColor3 = Color3.fromRGB(160, 160, 170)
        if connectionLoop then
            connectionLoop:Disconnect()
            connectionLoop = nil
        end
    end
end)

