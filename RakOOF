-- 6. TELEPORT TO NEAREST SPAWN LOGIC
--------------------------------------------------------------------------------
local function teleportToNearestSpawn()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    local nearestSpawn = nil
    local shortestDistance = math.huge
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") then
            local dist = (hrp.Position - obj.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                nearestSpawn = obj
            end
        end
    end
    
    if nearestSpawn then
        hrp.CFrame = nearestSpawn.CFrame + Vector3.new(0, 3.5, 0)
    end
end

SpawnBtn.MouseButton1Click:Connect(teleportToNearestSpawn)

