-- 4. TELEPORT TO ROCK MESH
--------------------------------------------------------------------------------
RockBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    
    -- Check ReplicatedStorage first, then fall back to Workspace
    local rockObj = ReplicatedStorage:FindFirstChild("rock", true) or Workspace:FindFirstChild("rock", true)
    
    if rockObj then
        if rockObj:IsA("BasePart") then
            hrp.CFrame = rockObj.CFrame
        elseif rockObj:IsA("Model") then
            local targetPart = rockObj.PrimaryPart or rockObj:FindFirstChildWhichIsA("BasePart")
            if targetPart then
                hrp.CFrame = targetPart.CFrame
            else
                warn("Rock model found, but contains no valid parts to teleport to.")
            end
        end
    else
        warn("Mesh/Part named 'rock' was not found in ReplicatedStorage or Workspace.")
    end
end)

--------------------------------------------------------------------------------
-- 5. TELEPORT TO SAFEZONE (READY GUY / NPC)
--------------------------------------------------------------------------------
local function findSafezoneNPC()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) then
            local nameLower = string.lower(obj.Name)
            
            if string.find(nameLower, "ready") or string.find(nameLower, "safe") or string.find(nameLower, "spawn") or string.find(nameLower, "npc") then
                local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj.PrimaryPart
                if root then return root end
            end
            
            if obj:FindFirstChildOfClass("Tool") or obj:FindFirstChild("Pan") or obj:FindFirstChild("FryingPan") then
                local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj.PrimaryPart
                if root then return root end
            end
        end
    end
    
    for _, gui in ipairs(Workspace:GetDescendants()) do
        if gui:IsA("TextLabel") and string.find(string.lower(gui.Text), "ready") then
            local parentPart = gui:FindFirstAncestorOfClass("BasePart") or gui:FindFirstAncestorOfClass("Model")
            if parentPart then
                return parentPart:IsA("Model") and (parentPart.PrimaryPart or parentPart:FindFirstChild("HumanoidRootPart")) or parentPart
            end
        end
    end

    return nil
end

SafezoneBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local targetNPC = findSafezoneNPC()
    if targetNPC then
        if targetNPC:IsA("BasePart") then
            character.HumanoidRootPart.CFrame = targetNPC.CFrame * CFrame.new(0, 0, -3)
        elseif targetNPC:IsA("Model") and targetNPC.PrimaryPart then
            character.HumanoidRootPart.CFrame = targetNPC.PrimaryPart.CFrame * CFrame.new(0, 0, -3)
        end
    else
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("SpawnLocation") then
                character.HumanoidRootPart.CFrame = obj.CFrame + Vector3.new(0, 3.5, 0)
                break
            end
        end
    end
end)

